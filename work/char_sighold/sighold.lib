  cell (sg13g2_hv_sighold) {
    area : 20.5632 ;
    cell_footprint : "sighold" ;
    dont_touch : true ;
    dont_use : true ;
    cell_leakage_power : 0.066716 ;
    pin (SH) {
      direction : inout ;
      driver_type : bus_hold ;
      rise_capacitance : 0.003638 ;
      fall_capacitance : 0.003638 ;
      capacitance : 0.003638 ;
    } /* end pin */
    pg_pin (VDD) {
      voltage_name : VDD ;
      pg_type : primary_power ;
    } /* end pg_pin */
    pg_pin (VSS) {
      voltage_name : VSS ;
      pg_type : primary_ground ;
    } /* end pg_pin */
    leakage_power () {
      when : "SH" ;
      value : 0.071029 ;
    } /* end leakage_power */
    leakage_power () {
      when : "!SH" ;
      value : 0.062403 ;
    } /* end leakage_power */
  } /* end cell */
