#!/bin/sh
# ngspice wrapper that preloads the IHP OSDI (Verilog-A) device models.
#
# Why this exists:
#   PySpice -- and therefore CharLib -- drives ngspice in server mode
#   (`ngspice -s`, netlist on stdin). ngspice reads `.spiceinit` in batch and
#   interactive mode, but NOT in server mode, so the `osdi ...psp103.osdi`
#   lines in the PDK's .spiceinit never run. Every SG13G2 MOSFET is a PSP103
#   Verilog-A model loaded through OSDI, so without them ngspice reports
#       Unknown model type psp103va - ignored
#       Unable to find definition of model ...:sg13g2_hv_nmos_psp
#   and refuses to parse the circuit.
#
#   Commands prefixed with `pre_` inside a .control block are executed before
#   the netlist is parsed, so injecting a `pre_osdi` block straight after the
#   title line loads the models in time. Verified to give results identical to
#   a batch-mode run that picks the same models up from .spiceinit.
#
# Everything except server mode is passed through untouched.
set -e

REAL=/foss/tools/bin/ngspice
OSDI_DIR=${PDK_ROOT:-/foss/pdks}/${PDK:-ihp-sg13g2}/libs.tech/ngspice/osdi

# Set NGSPICE_SHIM_DUMP to a directory to keep a copy of every deck that goes
# through the shim -- useful when a characterization run misbehaves and you
# need to see what the driving tool actually generated.
for arg in "$@"; do
    if [ "$arg" = "-s" ] || [ "$arg" = "--server" ]; then
        {
            IFS= read -r title || title="* charlib"
            printf '%s\n' "$title"
            printf '.control\n'
            # Server mode ignores .spiceinit, so the thread count set there is
            # ignored too and each ngspice defaults to several threads. A
            # characterizer runs many of these concurrently, and the product
            # oversubscribes the machine badly enough that runs which take
            # 0.4s alone take minutes. Pin it here; the caller controls
            # parallelism at the job level instead.
            printf 'pre_set num_threads=%s\n' "${NGSPICE_SHIM_THREADS:-1}"
            for m in psp103 psp103_nqs r3_cmc mosvar; do
                [ -f "$OSDI_DIR/$m.osdi" ] && printf 'pre_osdi %s\n' "$OSDI_DIR/$m.osdi"
            done
            printf '.endc\n'
            cat
        } | {
            if [ -n "$NGSPICE_SHIM_DUMP" ]; then
                mkdir -p "$NGSPICE_SHIM_DUMP"
                tee "$NGSPICE_SHIM_DUMP/deck.$$.cir" | "$REAL" "$@"
            else
                exec "$REAL" "$@"
            fi
        }
        exit $?
    fi
done

exec "$REAL" "$@"
